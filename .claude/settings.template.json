      "Bash(source:*)",
      "Bash(invar guard:*)",
      "Bash(invar sig:*)",
      "Bash(invar map:*)",
      "Bash(invar test:*)",
      "Bash(invar verify:*)",
      "Bash(invar rules:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git push)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ruff:*)",
      "Bash(INVAR_MODE=agent invar guard:*)",
      "Bash(python -m invar.shell.cli guard:*)"
