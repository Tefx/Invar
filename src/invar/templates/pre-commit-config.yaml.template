# Invar Pre-commit Hooks
# Install: pre-commit install
# Note: pre-commit manages its own environment, works with any venv manager (poetry, uv, etc.)

repos:
  - repo: local
    hooks:
      # Invar Guard - Architecture verification (REQUIRED)
      # Checks: contracts, file size, imports, etc.
      - id: invar-guard
        name: Invar Guard
        entry: invar guard --changed
        language: python
        additional_dependencies: ['python-invar']
        pass_filenames: false
        stages: [pre-commit]
        types: [python]

  # Optional: Uncomment to enable strict doctest verification
  # Note: Will fail if Python files have no doctests (exit code 5)
