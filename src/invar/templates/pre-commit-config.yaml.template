# Invar Pre-commit Hooks
# Install: pre-commit install
# Note: pre-commit manages its own environment, works with any venv manager (poetry, uv, etc.)

repos:
  - repo: local
    hooks:
      # Invar Guard - Architecture verification
      - id: invar-guard
        name: Invar Guard
        entry: invar guard --changed
        language: python
        additional_dependencies: ['python-invar']
        pass_filenames: false
        stages: [pre-commit]
        types: [python]

      # Pytest with doctests - Logic verification
      # Note: Customize src/ path if your project structure differs
      - id: pytest-doctest
        name: Pytest Doctests
        entry: pytest --doctest-modules src/ -q --tb=short
        language: python
        additional_dependencies: ['pytest']
        pass_filenames: false
        stages: [pre-commit]
        types: [python]
